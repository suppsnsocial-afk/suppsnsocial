# Stripe (required to take the real £1 workout unlock and 50p meal payments)
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Public site URL used for Checkout success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development only. Ignored when NODE_ENV=production.
# Lets you unlock workouts and individual meals without charging.
DEMO_UNLOCK=true

# Optional. Not required for v1 — unlock is confirmed by verifying
# the Checkout Session when Stripe returns the customer to the app.
# STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe test keys only. Never commit live keys or real secrets.
# A restricted test key (rk_test_...) is preferred. A secret test key (sk_test_...) also works.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Signing secret from `stripe listen` or the Dashboard webhook endpoint (test mode).
# stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# HMAC secret for the httpOnly unlock cookie. At least 32 characters.
# Generate a unique value. Do not reuse this placeholder.
UNLOCK_COOKIE_SECRET=replace_with_a_long_random_string_32b

# Public site origin for Checkout success and cancel URLs.
# Required in production. Host and X-Forwarded-Host are ignored.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel KV (Upstash REST). A shared server-side store is required in production.
# Local development uses an in-memory store persisted to .data/entitlements.json when these are unset.
KV_REST_API_URL=https://example.upstash.io
KV_REST_API_TOKEN=replace_me

# Append-only v1.1 accountancy ledger. One JSON object per line.
ACCOUNTANCY_LEDGER_PATH=.data/accountancy.jsonl

# Local development only. Ignored when NODE_ENV=production.
# Unlocks workouts and individual meals without charging.
DEMO_UNLOCK=true
